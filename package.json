{
  "name": "testautomation-web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint e2e playwright.config.js && prettier --check e2e playwright.config.js eslint.config.js",
    "format": "prettier --write e2e playwright.config.js eslint.config.js"
  },
  "dependencies": {
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^4.3.4",
    "eslint": "^10.10.0",
    "eslint-plugin-playwright": "^2.11.0",
    "prettier": "^3.9.6",
    "vite": "^4.4.9",
    "vitest": "^0.34.6"
  },
  "engines": {
    "node": ">=22"
  }
}
